. capture program drop aju_mean_table

. program define aju_mean_table
  1.     syntax anything, SHEET(string) MODULE(string) [XLSX(string) GRAPH(stri
> ng) GRAPHVARS(string) TITLE(string) GAP]
  2. 
.     tempfile out
  3.     tempname memhold
  4.     postfile `memhold' str80 module str80 variable str160 label ///
>         long n double mean sd min p25 p50 p75 max gap using `out', replace
  5. 
.     local clean_module "`module'"
  6.     local rawvars `anything'
  7.     local sample_n = _N
  8. 
.     foreach v of local rawvars {
  9.         capture confirm numeric variable `v'
 10.         if !_rc {
 11.             quietly count if !missing(`v')
 12.             local n = r(N)
 13.             local vlab : variable label `v'
 14.             if `"`vlab'"' == "" local vlab "`v'"
 15.             local vlab = substr(`"`vlab'"', 1, 160)
 16. 
.             if `n' > 0 {
 17.                 quietly summarize `v', detail
 18.                 local mean = r(mean)
 19.                 local sd   = r(sd)
 20.                 local min  = r(min)
 21.                 local p25  = r(p25)
 22.                 local p50  = r(p50)
 23.                 local p75  = r(p75)
 24.                 local max  = r(max)
 25.                 local gapval = .
 26.                 if "`gap'" != "" & `mean' >= 0 & `mean' <= 1 local gapval 
> = 1 - `mean'
 27.             }
 28.             else {
 29.                 local mean   = .
 30.                 local sd     = .
 31.                 local min    = .
 32.                 local p25    = .
 33.                 local p50    = .
 34.                 local p75    = .
 35.                 local max    = .
 36.                 local gapval = .
 37.             }
 38. 
.             post `memhold' (`"`clean_module'"') (`"`v'"') (`"`vlab'"') ///
>                 (`n') (`mean') (`sd') (`min') (`p25') (`p50') (`p75') (`max')
>  (`gapval')
 39.         }
 40.     }
 41.     postclose `memhold'
 42. 
.     local outxlsx "${AJU_EXEC_XLSX}"
 43.     if `"`xlsx'"' != "" local outxlsx `"`xlsx'"'
 44. 
.     preserve
 45.         use `out', clear
 46.         drop if n == 0
 47.         order module variable label n mean sd min p25 p50 p75 max gap
 48.         if "`gap'" == "" drop gap
 49.         export excel using `"`outxlsx'"', sheet("`sheet'", replace) firstr
> ow(variables)
 50. 
.         if `"`graph'"' != "" {
 51.             * Counts/years remain in the workbook, not on a common score a
> xis.
.             local plotvars `rawvars'
 52.             if `"`graphvars'"' != "" local plotvars `graphvars'
 53.             gen byte __show = 0
 54.             foreach v of local plotvars {
 55.                 replace __show = 1 if variable == "`v'"
 56.             }
 57.             keep if __show == 1
 58.             assert min >= 0 & max <= 1 if n > 0
 59.             replace label = label + " (n=" + strtrim(string(n, "%9.0f")) +
>  ")"
 60.             quietly count if !missing(mean)
 61.             if r(N) > 0 {
 62.                 local graphname = strtoname("`graph'")
 63.                 local graphname = substr("`graphname'", 1, 32)
 64.                 local graphtitle `"`title'"'
 65.                 if `"`graphtitle'"' == "" local graphtitle "`sheet'"
 66. 
.                 * Native multiline category labels; keep full text in Excel.
.                 gsort -mean label
 67.                 gen __id = _n
 68.                 local category_labels ""
 69.                 forvalues i = 1/`=_N' {
 70.                     local text = label[`i']
 71.                     local line ""
 72.                     local lines ""
 73.                     local words : word count `text'
 74.                     forvalues j = 1/`words' {
 75.                         local word : word `j' of `text'
 76.                         if strlen(`"`line' `word'"') > 34 & `"`line'"' != 
> "" {
 77.                             local lines `"`lines' "`line'" "'
 78.                             local line `"`word'"'
 79.                         }
 80.                         else local line = strtrim(`"`line' `word'"')
 81.                     }
 82.                     local lines `"`lines' "`line'" "'
 83.                     local category_labels `"`category_labels' `i' `"`lines
> '"' "'
 84.                 }
 85.                 local graphheight = max(5, min(11, _N*.38 + 2.4))
 86.                 local category_size = max(1.25, min(2.4, 23/_N))
 87.                 graph hbar mean if !missing(mean), ///
>                     over(__id, relabel(`category_labels') label(labsize(`cate
> gory_size'))) ///
>                     bar(1, color("32 87 129")) ///
>                     blabel(bar, format(%4.2f) size(vsmall)) ///
>                     yscale(range(0 1)) ylabel(0(.2)1, format(%3.1f) grid) ///
>                     ytitle("Mean score / share (0-1)") ///
>                     xsize(12) ysize(`graphheight') graphregion(margin(l=27 r=
> 3)) ///
>                     title(`"`graphtitle'"', size(medsmall) span) ///
>                     note("Observed selected-list interviews: N=`sample_n'; it
> em N shown." ///
>                          "Scores and shares differ; evidence types are detail
> ed in Excel.", size(vsmall) span) ///
>                     name(`graphname', replace)
 88. 
.                 graph export "${AJU_FIG_DIR}/`graph'.png", replace width(2400
> )
 89.                 graph export "${AJU_FIG_DIR}/`graph'.pdf", replace
 90.             }
 91.         }
 92.     restore
 93. end

