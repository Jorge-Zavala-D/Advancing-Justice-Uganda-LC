. local regression_outcomes ///
>     idx_lcc_operational_capacity ///
>     idx_lcc_case_handling_quality ///
>     idx_lcc_legitimacy_and_norms ///
>     idx_p1_base_mentor_ready_proxy ///
>     idx_record_quality ///
>     idx_referral_practice ///
>     idx_safeguards

. 
. foreach y of local regression_outcomes {
  2.     capture confirm numeric variable `y'
  3.     if !_rc {
  4.         quietly count if !missing(`y', p1_admin_previously_contacted, cano
> nical_district)
  5.         local n = r(N)
  6. 
.         quietly summarize `y' if p1_admin_previously_contacted == 0, meanonly
  7.         local mean0 = r(mean)
  8. 
.         quietly summarize `y' if p1_admin_previously_contacted == 1, meanonly
  9.         local mean1 = r(mean)
 10. 
.         local b = .
 11.         local se = .
 12.         local p = .
 13. 
.         if `n' > 5 {
 14.             capture quietly regress `y' i.p1_admin_previously_contacted i.
> district_id, vce(robust)
 15.             if !_rc {
 16.                 local b = _b[1.p1_admin_previously_contacted]
 17.                 local se = _se[1.p1_admin_previously_contacted]
 18.                 local p = 2 * ttail(e(df_r), abs(`b' / `se'))
 19.             }
 20.         }
 21. 
.         local ylab : variable label `y'
 22.         if `"`ylab'"' == "" local ylab "`y'"
 23.         local ylab = substr(`"`ylab'"', 1, 160)
 24. 
.         post `regpost' ///
>             (`"`y'"') ///
>             (`"`ylab'"') ///
>             (`n') ///
>             (`b') ///
>             (`se') ///
>             (`p') ///
>             (`mean0') ///
>             (`mean1')
 25.     }
 26. }

. 
. postclose `regpost'

. 
. preserve

.     use `origin_regressions', clear

.     gen raw_diff_prev_minus_new = mean_prev - mean_new

.     gen ci_low = coef_prev_contacted - invttail(n-4, .025)*se

.     gen ci_high = coef_prev_contacted + invttail(n-4, .025)*se

