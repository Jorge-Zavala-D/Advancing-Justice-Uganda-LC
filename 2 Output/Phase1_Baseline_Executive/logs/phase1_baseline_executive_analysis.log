. * Preserve an in-memory checksum of every analytical index. Analysis may summ
> arize
. * or label these variables, but must never change their values.
. local index_counter = 0

. foreach v of local all_indices {
  2.     assert inrange(`v', 0, 1) if !missing(`v')
  3.     quietly summarize `v', meanonly
  4.     local ++index_counter
  5.     local index_n`index_counter' = r(N)
  6.     local index_sum`index_counter' = r(sum)
  7. }

