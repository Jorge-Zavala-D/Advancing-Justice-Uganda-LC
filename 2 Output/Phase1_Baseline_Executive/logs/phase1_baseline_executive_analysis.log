. * 15.2 Pairwise correlations with mentor-readiness proxy
. tempfile readiness_corrs

. tempname rc

. postfile `rc' str80 variable str160 label long n double corr_with_readiness u
> sing `readiness_corrs', replace
(file
    C:\Users\jzava\AppData\Local\Temp\stata_worker_default_7505d64a54_74609fe
    > 5bb_opml03wf\ST_e880_00003e.tmp not found)

. 
. foreach v of local core_indices {
  2.     capture confirm numeric variable `v'
  3.     if !_rc {
  4.         quietly count if !missing(idx_p1_base_mentor_ready_proxy, `v')
  5.         local n = r(N)
  6.         if `n' > 2 {
  7.             quietly corr idx_p1_base_mentor_ready_proxy `v'
  8.             matrix R = r(C)
  9.             local rho = R[1,2]
 10.         }
 11.         else {
 12.             local rho = .
 13.         }
 14.         local vl : variable label `v'
 15.         if `"`vl'"' == "" local vl "`v'"
 16.         post `rc' (`"`v'"') (`"`vl'"') (`n') (`rho')
