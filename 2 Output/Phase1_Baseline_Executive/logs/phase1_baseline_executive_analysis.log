. *----------------------------------------------------------------------------
> --*
. **# 18.3 Candidate difference table
. *----------------------------------------------------------------------------
> --*
. * Produces a broad comparison table with:
. *   - N and mean in new villages
. *   - N and mean in previously contacted villages
. *   - Difference: previously contacted minus new
. *   - Two-sided p-value from a simple t-test
. *
. * P-values are descriptive diagnostics only. No causal interpretation.
. *----------------------------------------------------------------------------
> --*
. 
. tempfile origin_diffs

. tempname memhold

. 
. postfile `memhold' ///
>     str40 domain ///
>     str80 variable ///
>     str180 label ///
>     long n_new ///
>     double mean_new ///
>     long n_prev ///
>     double mean_prev ///
>     double diff_prev_minus_new ///
>     double p_value ///
>     double abs_diff ///
>     using `origin_diffs', replace
(file
    C:\Users\jzava\AppData\Local\Temp\stata_worker_default_7505d64a54_74609fe
    > 5bb_opml03wf\ST_e880_000060.tmp not found)

. 
. foreach v of local candvars {
  2. 
.     capture confirm numeric variable `v'
  3.     if !_rc {
  4. 
. local domain "Other/context"
  5. if strpos(" `corevars' ", " `v' ") > 0 local domain "Core composites"
  6. if strpos(" `domainvars' ", " `v' ") > 0 local domain "Domain indices"
  7. if strpos(" `jlosvars' ", " `v' ") > 0 local domain "JLOS/referral collabo
> ration"
  8. if strpos(" `recsafevars' ", " `v' ") > 0 local domain "Records and safegu
> ards"
  9. if strpos(" `legreintvars' ", " `v' ") > 0 local domain "Legitimacy and re
> integration"
 10. if strpos(" `mentorvars' ", " `v' ") > 0 local domain "Mentor-readiness fl
> ags"
 11. 
.         quietly count if p1_admin_previously_contacted == 0 & !missing(`v')
 12.         local n0 = r(N)
 13.         quietly summarize `v' if p1_admin_previously_contacted == 0, meano
> nly
 14.         local m0 = r(mean)
 15. 
.         quietly count if p1_admin_previously_contacted == 1 & !missing(`v')
 16.         local n1 = r(N)
 17.         quietly summarize `v' if p1_admin_previously_contacted == 1, meano
> nly
 18.         local m1 = r(mean)
 19. 
.         local diff = .
 20.         if `n0' > 0 & `n1' > 0 local diff = `m1' - `m0'
 21. 
.         local pval = .
 22.         if `n0' > 1 & `n1' > 1 {
 23.             capture quietly ttest `v', by(p1_admin_previously_contacted)
 24.             if !_rc local pval = r(p)
 25.         }
 26. 
.         local adiff = abs(`diff')
 27. 
.         local vlab : variable label `v'
 28.         if `"`vlab'"' == "" local vlab "`v'"
 29.         local vlab = substr(`"`vlab'"', 1, 180)
 30. 
.         post `memhold' ///
>             (`"`domain'"') ///
>             (`"`v'"') ///
>             (`"`vlab'"') ///
>             (`n0') ///
>             (`m0') ///
>             (`n1') ///
>             (`m1') ///
>             (`diff') ///
>             (`pval') ///
>             (`adiff')
 31.     }
 32. }

. 
. postclose `memhold'

. 
. preserve

.     use `origin_diffs', clear

. 
.     * Remove variables with no usable comparison
.     drop if missing(mean_new) & missing(mean_prev)
(0 observations deleted)

. 
.     format mean_new mean_prev diff_prev_minus_new p_value abs_diff %9.3f

. 
.     * Full diagnostic table
.     gsort domain -abs_diff

.     export excel using "`excel_origin'", sheet("final_diff_table", replace) f
